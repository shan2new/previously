# --- Server ---
# Which deployment this is: development | test | production. Production refuses the `dev:` bearer
# issuer outright, and the process refuses to boot if it is misconfigured (see src/auth/authConfig.ts).
APP_ENV=development
PORT=8787
# Comma-separated allowed CORS origins (use * for dev only)
CORS_ORIGIN=*

# --- Database (local Postgres on the Mac mini) ---
DATABASE_URL=postgres://localhost:5432/previously

# --- Clerk (provided separately) ---
# Networkless JWT verification key (PEM). If set, tokens are verified offline.
CLERK_JWT_KEY=
# Secret key for the Clerk backend SDK (fallback to JWKS verification).
CLERK_SECRET_KEY=
# Accept "Authorization: Bearer dev:<clerkId>" — LOCAL ONLY. Ignored when APP_ENV=production,
# and the server refuses to boot if production sets it. (1 to enable outside production.)
DEV_AUTH_BYPASS=0

# --- OpenRouter (key fetched from Daytona) ---
OPENROUTER_API_KEY=
# Flash-tier model for the interactive search grouping path (temperature-0 classification).
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Model for the daily bulk/eager grouping cron.
OPENROUTER_MODEL_BULK=google/gemini-3.1-flash-lite
# Pricier model reserved for genuinely ambiguous side-story splits (see groupingTier()).
OPENROUTER_MODEL_ESCALATE=anthropic/claude-haiku-4.5
# Set to 1 to skip real LLM calls and use the deterministic relation-graph grouping only.
GROUPING_LLM_DISABLED=0

# --- Cerebras (fast, cheap inference) ---
# When set, gpt-oss-120b is the default for franchise grouping (preferred over OpenRouter above)
# AND for spell-correcting a search that returned no AniList hits.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# Set to 1 to disable LLM spell-correction of zero-result searches.
SEARCH_CORRECT_DISABLED=0

# --- Sync ---
# Max trending franchises to seed on the daily job.
TRENDING_SEED_COUNT=300

# --- TMDB (general-TV source) ---
# v4 read access token (Bearer). Leave empty to disable TV search/sync (anime-only mode).
TMDB_ACCESS_TOKEN=

# --- News research agent ---
# Daily Claude Agent SDK web research over subscribed franchises (see src/news/). Set to 1 to skip it.
NEWS_AGENT_DISABLED=0
# Empty = the Agent SDK's default model.
NEWS_AGENT_MODEL=
NEWS_AGENT_MAX_TURNS=16
NEWS_AGENT_TIMEOUT_MS=300000
# On Claude quota/auth/transport failures, use isolated live web research via Codex CLI.
# Requires `codex login` (ChatGPT); ~/.local/bin is added to the subprocess PATH.
NEWS_CODEX_FALLBACK_ENABLED=1
NEWS_CODEX_COMMAND=codex
# Empty = the CLI default; desktop app model aliases may not be accepted by the CLI.
NEWS_CODEX_MODEL=
NEWS_CODEX_TIMEOUT_MS=180000
NEWS_MAX_FRANCHISES_PER_RUN=25
NEWS_CHECK_INTERVAL_HOURS=20

# --- Social (Today feed) ---
# Comments and replies. On here, for local work. The server's DEFAULT is OFF (a key missing from a
# host's .env keeps comments off): a production host sets 1 only once the published terms carry the
# UGC clause and the production Clerk instance exists (docs/beta-release.md). Likes, saves,
# reminders, hides and ratings keep working either way.
SOCIAL_COMMENTS_ENABLED=1
# The community-rules version a user must accept (POST /me/terms) before posting. Bump it whenever
# the rules text the app shows changes, so everyone accepts the new text.
SOCIAL_TERMS_VERSION=2026-09-25.2
# Distinct reports that auto-hide a comment.
SOCIAL_AUTO_HIDE_REPORTS=3
# At most one fresh "liked your comment" row per comment per this many minutes (unread rows aggregate).
SOCIAL_LIKE_NOTIFY_COOLDOWN_MINUTES=60
# How long the in-process ban list is cached; a CLI ban takes effect within this many seconds.
SOCIAL_BAN_CACHE_SECONDS=60
# A report counts toward auto-hide only when the reporter's account is at least this many hours old
# (every report is still stored, logged and alerted). 0 counts every account.
SOCIAL_REPORTER_MIN_AGE_HOURS=24
# An https webhook that receives report alerts (first report on a comment, every auto-hide, and an
# hourly nudge while reports older than 12 h are open). Empty = the server log only. The payload
# carries no comment text and no handle.
MODERATION_ALERT_WEBHOOK_URL=
# Per-user, in-process rate limits (keyed on the Clerk id, never the IP). 1 disables them — local
# only: APP_ENV=production refuses to boot with it set.
SOCIAL_RATE_LIMIT_DISABLED=0
SOCIAL_RATE_COMMENTS_PER_MINUTE=5
SOCIAL_RATE_COMMENTS_PER_HOUR=60
SOCIAL_RATE_TOGGLES_PER_MINUTE=120
SOCIAL_RATE_REPORTS_PER_HOUR=20
SOCIAL_RATE_BLOCKS_PER_HOUR=30
SOCIAL_RATE_PROFILE_PER_DAY=10
SOCIAL_RATE_EXPORTS_PER_HOUR=3
# Hourly comment budget while an account is less than a day old (instead of COMMENTS_PER_HOUR).
SOCIAL_RATE_NEW_COMMENTS_PER_HOUR=10
# 422 refusals (content filter, handle/name rules) per hour before they answer 429.
SOCIAL_RATE_REJECTED_PER_HOUR=20
# GET /me/feed, GET /social/comments and GET /feed/posts/:id, together, per minute.
SOCIAL_RATE_READS_PER_MINUTE=120
