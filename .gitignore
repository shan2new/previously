node_modules
dist
*.local
.DS_Store
.env
.env.*
!.env.example
*.log

# Plain-SQL data dump — contains user emails + Clerk IDs, must never be committed
previously-2026-06-24.sql

# Local fastembed ONNX model cache (re-downloadable, ~87MB)
.fastembed_cache/

# Capture/QA screenshot archive (1.3 GB of simulator PNGs — regenerable, never committed)
qa/
!ios/Tools/qa/
!server/qa/
!docs/qa/
ios/Tools/qa/.runs/
ios/Tools/qa/__pycache__/
server/qa/__pycache__/

# Android design-QA captures (regenerated by docs/android-port/qa/capture.sh)
qa-shots/

# Icon exploration RENDERS (166 MB of intermediate 1024² PNGs across app-icon-v2/out*, out2…out4,
# unfitted-originals and app-icon-tv/previews). The generators that produce them ARE committed
# (design/app-icon-v2/*.py), and the icon that actually shipped lives in
# ios/Resources/AppIcon.icon and android/app/src/main/res — so these are regenerable scratch.
design/app-icon-v2/**/*.png
design/app-icon-tv/**/*.png

# Discover's genre art INPUTS (≈50 MB): the Codex-generated sources, the importer's QA renders and
# its contact sheets. What ships is the graded output in ios/Resources/Assets.xcassets/Genres
# (committed), made from these by icon/genres/import.py (committed, with the brief in its README).
icon/genres/src/
icon/genres/qa/
icon/genres/sheet-*.png

# The Split-Flap icon's renders and in-context previews — regenerable from design/app-icon-splitflap/src
# (committed); the icon that ships is ios/Resources/AppIcon.icon.
design/app-icon-splitflap/renders/
design/app-icon-splitflap/handover.png
design/app-icon-splitflap/src/*.png

# First-run scratch server log (design/onboarding-2026-10-04/run-first-run.sh)
design/onboarding-2026-10-04/*.local.log

# Load-test raw dumps (52 MB of readiness and host samples per run): kept on disk, not in git.
docs/qa/*/load-testing/*/ready.json
docs/qa/*/load-testing/*/host-resource-samples.json
